# Apollo Green Solutions — Environment Variables Template
#
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local or any file containing real secrets to git.
# The .gitignore is configured to block all .env* files except this one.

# ─── Contact Form / Email Delivery ───────────────────────────────────────────
# Resend API key used by /api/contact for transactional email delivery.
RESEND_API_KEY=

# Destination address for submitted contact forms.
CONTACT_FORM_TO_EMAIL=

# Verified Resend sender, for example "Apollo website <hello@yourdomain.com>".
CONTACT_FORM_FROM_EMAIL=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Upstash Redis URL + token for edge-compatible rate limiting (optional).
# If not set, the in-memory fallback is used (not suitable for multi-instance production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── App Metadata ─────────────────────────────────────────────────────────────
# Public base URL used for OG image generation and sitemap. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Analytics (optional) ─────────────────────────────────────────────────────
# Add your analytics provider credentials here (e.g. Vercel Analytics is automatic).
# Example: NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
